{
  "name": "jade-revamp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "package:deploy": "node scripts/package-deploy.mjs",
    "typecheck": "tsc --noEmit",
    "blogs:import:wordpress": "node scripts/import-wordpress-blogs.mjs",
    "blogs:verify:wordpress": "node scripts/verify-wordpress-blogs.mjs",
    "dev": "next dev --turbo",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbo",
    "dev:webpack": "next dev",
    "prebuild": "node scripts/generate_media_manifest.mjs",
    "generate-favicons": "node scripts/generate_favicons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && cross-env CI=true playwright test",
    "optimize-images": "node scripts/optimize_public_images.mjs",
    "optimize-images:dry-run": "node scripts/optimize_public_images.mjs --dry-run",
    "db:seed": "node scripts/seed-villas.mjs",
    "db:seed:users": "node scripts/seed-users.mjs",
    "db:test": "node scripts/test-mongo.mjs",
    "db:start": "node scripts/start-jade-mongo.mjs",
    "db:migrate": "node scripts/migrate-mongo.mjs migrate",
    "db:migrate:dump": "node scripts/migrate-mongo.mjs dump",
    "db:migrate:restore": "node scripts/migrate-mongo.mjs restore",
    "db:migrate:verify": "node scripts/migrate-mongo.mjs verify",
    "db:migrate:smoke": "node scripts/verify-mongo-migration.mjs",
    "api:smoke": "node scripts/smoke-api-live.mjs",
    "setup:check": "node scripts/verify-local-setup.mjs",
    "axis:seed": "node scripts/seed-axis-sandbox.mjs",
    "axis:test": "node scripts/test-axisrooms-sandbox.mjs",
    "axis:inbound-test": "node scripts/test-inbound-webhook.mjs",
    "email:test": "node scripts/test-resend-email.mjs",
    "axis:configure:production": "node scripts/configure-axis-production.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@sentry/nextjs": "^10.51.0",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-horizontal-rule": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@uiw/react-codemirror": "^4.25.10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "heic-convert": "^2.1.0",
    "isomorphic-dompurify": "^3.18.0",
    "js-beautify": "^1.15.4",
    "lenis": "^1.3.17",
    "lucide-react": "^0.395.0",
    "mongoose": "^9.6.2",
    "next": "14.2.4",
    "next-auth": "^4.24.14",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.16.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "mongodb-memory-server": "^11.2.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
