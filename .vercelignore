.DS_Store

# Unserved camera originals; the application uses converted images.
**/*.CR2
**/*.cr2

# Runtime secrets must be configured in Vercel, never uploaded as source.
.env*
!.env.example

# Tests remain in the development workspace.
**/*.test.*
**/*.spec.*
vitest.config.ts
playwright.config.ts
