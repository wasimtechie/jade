# Upload application source and served assets, not local state.
node_modules/
.next/
dist/
tmp/
images/
.git/
.github/
.vscode/
.postman/
postman/
coverage/
playwright-report/
test-results/
e2e/
logs/
__pycache__/
*.pyc
